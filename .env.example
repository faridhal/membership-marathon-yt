# Salin jadi .env lalu isi. Jangan commit file .env.

# Channel YouTube yang dipantau (dikunci, tidak bisa diubah dari control panel).
YT_CHANNEL=@channelkamu

# Password untuk masuk ke control panel. Pakai password yang panjang.
ADMIN_PASSWORD=ganti-dengan-password-panjang

# Domain untuk HTTPS. Tanpa domain sendiri, pakai IP VM + sslip.io, mis. 34-12-56-78.sslip.io
DOMAIN=34-12-56-78.sslip.io

# Opsional: kunci acak untuk cookie login (default diturunkan dari ADMIN_PASSWORD).
# SESSION_SECRET=
